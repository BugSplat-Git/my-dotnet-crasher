<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyDotNetWinUI3Crasher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MyDotNetWinUI3Crasher">
    <Grid Background="{StaticResource ScreenBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="32,24,32,28">
                <Grid MaxWidth="800" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top bar: logo + version + connected pill -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="ms-appx:///Assets/bugsplat-logo.png"
                               Stretch="Uniform" MaxHeight="26" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="10" Padding="10,3">
                                <TextBlock x:Name="VersionChip" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                            </Border>
                            <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="10" Padding="10,3">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource ConnectedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Connected" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Title block -->
                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,22">
                        <TextBlock Text="BugSplat .NET SDK &#183; Demo" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Trigger an event. We catch it, group it, and route it to your dashboard."
                                   FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Section label -->
                    <TextBlock Grid.Row="2" Text="TRIGGER AN EVENT" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="2,0,0,10" />

                    <!-- Event card grid -->
                    <Grid Grid.Row="3" Margin="0,0,0,22" ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource EventCardButtonStyle}" Click="CrashCard_Click">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="ms-appx:///Assets/splat_crash.png" Width="40" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Crash" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Unhandled exception &#183; managed stack + native minidump" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource EventCardButtonStyle}" Click="NonCrashErrorCard_Click">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="ms-appx:///Assets/splat_error.png" Width="40" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Non-Crash Error" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Post a caught exception &#183; app keeps running" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource EventCardButtonStyle}" Click="UserFeedbackCard_Click">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="ms-appx:///Assets/splat_feedback.png" Width="40" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="User Feedback" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Send a note &#183; returns a crash id" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource EventCardButtonStyle}" Click="HangCard_Click">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="ms-appx:///Assets/splat_hang.png" Width="40" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Hang" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Freeze the UI thread until BugSplat reports the hang" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource EventCardButtonStyle}" Click="MixedModeCard_Click">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="ms-appx:///Assets/splat_crash.png" Width="40" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Mixed-Mode Crash" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Managed &#8594; native access violation &#183; one unified C#/C++ stack" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Recent activity -->
                    <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RECENT ACTIVITY" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <HyperlinkButton Grid.Column="1" Content="View dashboard &#8599;" Padding="4,0" Click="ViewDashboard_Click" />
                            </Grid>
                            <StackPanel x:Name="RecentActivityPanel" Spacing="8" />
                            <TextBlock x:Name="RecentActivityEmpty" Text="No activity yet." FontSize="13"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
