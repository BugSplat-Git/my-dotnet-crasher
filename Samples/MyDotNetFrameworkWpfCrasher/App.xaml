<Application
    x:Class="MyDotNetFrameworkWpfCrasher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- BugSplat sample design system (shared with the WinUI 3 samples). -->
        <SolidColorBrush x:Key="ScreenBgBrush" Color="#FAF8F2" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#F7F6F1" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#ECEAE2" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0E1116" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="BadgeBgBrush" Color="#F1EFE8" />
        <SolidColorBrush x:Key="LinkBrush" Color="#1F73E8" />
        <SolidColorBrush x:Key="FeedbackAccentBrush" Color="#4E9D78" />
        <SolidColorBrush x:Key="ConnectedBrush" Color="#22C55E" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="EventCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="16">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource FeedbackAccentBrush}" CornerRadius="8" Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoxedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        </Style>
    </Application.Resources>
</Application>
