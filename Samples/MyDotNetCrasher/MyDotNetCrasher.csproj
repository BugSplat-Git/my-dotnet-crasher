<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- MyDotNetCrasherNative is built for x64 only. -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Copy BugSplatDotNet.pdb from the package to the output, so the symbol upload covers it. -->
    <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>

    <!-- The native crash DLL the mixed-mode (C#/C++) modes P/Invoke. Built by
         MyDotNetCrasherNative.vcxproj (x64) into its own bin; consumed here as a prebuilt
         file since a .NET SDK project cannot build a vcxproj under `dotnet build`. -->
    <NativeCrasherBin>..\MyDotNetCrasherNative\bin\x64\$(Configuration)\</NativeCrasherBin>
  </PropertyGroup>

  <!-- BugSplat for .NET. The package also copies BugSplat's native runtime (BugSplat.dll,
       BugSplatMonitor.exe, BugSplatReporter.exe, BugSplatWer.dll) next to the exe. -->
  <ItemGroup>
    <PackageReference Include="BugSplat" Version="9.0.1" />
  </ItemGroup>

  <!-- Native crash surface for the mixed-mode modes (+ its PDB, so BugSplat can symbolicate the
       native half of the stack). -->
  <ItemGroup>
    <Content Include="$(NativeCrasherBin)MyDotNetCrasherNative.dll" Link="MyDotNetCrasherNative.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NativeCrasherBin)MyDotNetCrasherNative.pdb" Link="MyDotNetCrasherNative.pdb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Scripts\SymbolUpload.ps1" />
  </ItemGroup>

  <!-- Sends the exe, DLLs and their .pdb files (including MyDotNetCrasherNative's) to BugSplat so
       crash stacks show file and line numbers. Needs Scripts\env.ps1 (or BUGSPLAT_CLIENT_ID /
       BUGSPLAT_CLIENT_SECRET); see the README. To skip it, build with /p:BugSplatSymbolUpload=false. -->
  <Target Name="BugSplatSymbolUpload" AfterTargets="Build" Condition="'$(BugSplatSymbolUpload)' != 'false'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Scripts\SymbolUpload.ps1&quot; -projectDir &quot;$(ProjectDir)\&quot; -outDir &quot;$(TargetDir)\&quot;" />
  </Target>

</Project>
